# ==============================================================================
# Telegram Media Leecher - Environment Configuration Example
# ==============================================================================

# 1. Telegram API Credentials
# Obtain these from https://my.telegram.org (under 'API development tools')
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# Path to the Telethon session file (without .session extension)
TG_SESSION_PATH=./data/telegram_session

# 2. Telegram Group / Chat
# Exact title of the Telegram group (or chat ID) where you forward videos
TARGET_CHAT=Jellyfin

# 3. Download Directories (Local paths or container paths)
DOWNLOAD_DIR_FILMS=/media/films
DOWNLOAD_DIR_SERIES=/media/series
DOWNLOAD_DIR_ANIMES=/media/animes
DOWNLOAD_DIR_ADULTE=/media/adulte

# 4. Jellyfin Integration (Optional)
# If enabled, triggers a library scan once a download finishes
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
